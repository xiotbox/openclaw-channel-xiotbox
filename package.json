{
  "name": "xiotbox",
  "version": "5.0.3",
  "description": "OpenClaw XiotBox channel plugin with remote chat delivery, optional device-control tools, and bridge-mode support.",
  "type": "module",
  "main": "dist/index.js",
  "homepage": "https://github.com/xiotbox/openclaw-channel-xiotbox",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xiotbox/openclaw-channel-xiotbox.git"
  },
  "bugs": {
    "url": "https://github.com/xiotbox/openclaw-channel-xiotbox/issues"
  },
  "keywords": [
    "openclaw",
    "openclaw-plugin",
    "xiotbox",
    "channel",
    "bridge",
    "device-control",
    "websocket"
  ],
  "author": "OnGood",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "node bridge.js",
    "build": "tsc -p tsconfig.json",
    "clean": "rm -rf dist",
    "prepack": "npm run build",
    "release:check": "node scripts/release_check.mjs",
    "contract:openclaw": "node scripts/check_openclaw_contract.mjs",
    "check:env": "node scripts/check_no_env_outside_runtime_config.mjs",
    "spike:entry": "node scripts/spike_openclaw_entry_3_1.mjs",
    "test": "node --test test/*.test.mjs"
  },
  "dependencies": {
    "@noble/curves": "^1.4.0",
    "ws": "^8.21.0",
    "dotenv": "^16.0.3"
  },
  "peerDependencies": {
    "openclaw": ">=2026.7.1 <2026.9.0"
  },
  "peerDependenciesMeta": {
    "openclaw": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.8.0"
  },
  "files": [
    "src",
    "index.ts",
    "setup-entry.ts",
    "dist",
    "docs",
    "openclaw.plugin.json",
    "README.md",
    ".env.example",
    "wss_client.js",
    "bridge.js",
    "config.js",
    "executor.js"
  ],
  "openclaw": {
    "extensions": [
      "./index.ts"
    ],
    "setupEntry": "./setup-entry.ts",
    "channels": [
      "xiotbox"
    ],
    "installDependencies": true,
    "install": {
      "npmSpec": "xiotbox",
      "localPath": "extensions/xiotbox",
      "defaultChoice": "local",
      "minHostVersion": ">=2026.7.1"
    },
    "channel": {
      "id": "xiotbox",
      "label": "XiotBox",
      "selectionLabel": "XiotBox Gateway",
      "blurb": "Connects to XiotBox Gateway via WebSocket Secure (WSS) protocol.",
      "docsPath": "README.md",
      "order": 100
    },
    "contracts": {
      "tools": [
        "xiotbox_local_control",
        "xiotbox_control"
      ]
    }
  }
}
